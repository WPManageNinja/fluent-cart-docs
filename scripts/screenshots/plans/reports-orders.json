{
  "site": "https://fcdemo.lab",
  "user": "admin",
  "pass": "admin",
  "outDir": "guide/public/images/reporting-analytics/orders",
  "viewport": {
    "width": 1600,
    "height": 3400
  },
  "steps": [
    {
      "admin": "/reports/orders"
    },
    {
      "css": ".fct-notices-wrap, .notice.fluent-cart-notice, #wpbody-content > .notice {display:none !important}"
    },
    {
      "eval": "new Promise(res => { const t0 = Date.now(); const tick = () => { const busy = [...document.querySelectorAll('.el-skeleton__item, .el-loading-mask, .fct-summary-loader')].filter(e => e.offsetParent !== null); if (!busy.length || Date.now() - t0 > 25000) return res(busy.length); setTimeout(tick, 300); }; setTimeout(tick, 800); })"
    },
    {
      "wait": 1500
    },
    {
      "shot": {
        "name": "orders-order-mix",
        "clip": {
          "element": {
            "selector": ".fct-card",
            "hasText": "Order mix"
          },
          "pad": 20
        }
      }
    },
    {
      "shot": {
        "name": "orders-new-vs-returning",
        "clip": {
          "element": {
            "selector": ".fct-card",
            "hasText": "New vs. Returning Customers"
          },
          "pad": 20
        },
        "arrows": [
          {
            "target": ".el-checkbox:has-text(\"Show Percentages\")",
            "from": "left",
            "len": 150
          }
        ]
      }
    },
    {
      "shot": {
        "name": "orders-patterns",
        "clip": {
          "x": 430,
          "y": 2198,
          "width": 1160,
          "height": 1059
        }
      }
    },
    {
      "css": ".fct-report-order-summary.summary-col-6 { margin-top: 50px !important; }"
    },
    {
      "shot": {
        "name": "orders-summary-cards",
        "clip": {
          "x": 430,
          "y": 179,
          "width": 1160,
          "height": 747
        },
        "arrows": [
          {
            "target": ".summary-item .el-checkbox",
            "from": "top",
            "len": 100
          }
        ]
      }
    }
  ]
}
