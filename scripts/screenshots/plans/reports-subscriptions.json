{
  "site": "https://fcdemo.lab",
  "user": "admin",
  "pass": "admin",
  "outDir": "guide/public/images/reporting-analytics/subscription",
  "viewport": {
    "width": 1600,
    "height": 1600
  },
  "steps": [
    {
      "admin": "/reports/subscriptions"
    },
    {
      "css": ".fct-notices-wrap, .notice.fluent-cart-notice, #wpbody-content > .notice {display:none !important}"
    },
    {
      "eval": "new Promise(res => { const t0 = Date.now(); const tick = () => { const busy = [...document.querySelectorAll('.el-skeleton__item, .el-loading-mask, .fct-summary-loader')].filter(e => e.offsetParent !== null); if (!busy.length || Date.now() - t0 > 25000) return res(busy.length); setTimeout(tick, 300); }; setTimeout(tick, 800); })"
    },
    {
      "wait": 1500
    },
    {
      "shot": {
        "name": "subscriptions-right-now",
        "clip": {
          "x": 430,
          "y": 159,
          "width": 1160,
          "height": 330
        }
      }
    },
    {
      "shot": {
        "name": "subscriptions-period",
        "clip": {
          "x": 430,
          "y": 479,
          "width": 1160,
          "height": 713
        },
        "arrows": [
          {
            "target": {
              "selector": ".fct-card .el-radio-group",
              "hasText": "MRR"
            },
            "from": "bottom",
            "len": 130
          }
        ]
      }
    },
    {
      "shot": {
        "name": "subscriptions-mrr-breakdown",
        "clip": {
          "element": {
            "selector": ".fct-card",
            "hasText": "Where MRR comes from"
          },
          "pad": 20
        }
      }
    }
  ]
}
