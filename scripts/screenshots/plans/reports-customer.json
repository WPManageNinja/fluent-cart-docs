{
  "site": "https://fcdemo.lab",
  "user": "admin",
  "pass": "admin",
  "outDir": "guide/public/images/reporting-analytics/customer",
  "viewport": {
    "width": 1600,
    "height": 4400
  },
  "steps": [
    {
      "admin": "/reports/customer"
    },
    {
      "css": ".fct-notices-wrap, .notice.fluent-cart-notice, #wpbody-content > .notice {display:none !important}"
    },
    {
      "eval": "new Promise(res => { const t0 = Date.now(); const tick = () => { const busy = [...document.querySelectorAll('.el-skeleton__item, .el-loading-mask, .fct-summary-loader')].filter(e => e.offsetParent !== null); if (!busy.length || Date.now() - t0 > 25000) return res(busy.length); setTimeout(tick, 300); }; setTimeout(tick, 800); })"
    },
    {
      "wait": 1500
    },
    {
      "shot": {
        "name": "customers-cards",
        "clip": {
          "x": 430,
          "y": 215,
          "width": 1160,
          "height": 625
        },
        "arrows": [
          {
            "target": ".fct-customer-report-page .el-radio-group",
            "from": "bottom",
            "len": 110
          }
        ]
      }
    },
    {
      "shot": {
        "name": "customers-segments",
        "clip": {
          "element": {
            "selector": ".fct-card",
            "hasText": "Customer Segments"
          },
          "pad": 20
        },
        "arrows": [
          {
            "target": ".fct-card:has-text(\"Customer Segments\") .fct-card-body .el-button",
            "from": "bottom",
            "len": 110
          }
        ]
      }
    },
    {
      "shot": {
        "name": "customers-top-customers",
        "clip": {
          "element": {
            "selector": ".fct-card",
            "hasText": "Top Customers"
          },
          "pad": 20
        }
      }
    }
  ]
}
